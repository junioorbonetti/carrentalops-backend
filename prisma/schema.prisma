generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
}

model Vehicle {
  id             Int           @id @default(autoincrement())
  brand          String
  model          String
  year           Int
  plate          String        @unique
  vin            String?
  color          String
  status         String        @default("available") // available, rented, maintenance, inactive
  mileage        Int           @default(0)
  weeklyRate     Float
  notes          String?
  photoUrl       String?
  docExpiry      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  rentals        Rental[]
  maintenances   Maintenance[]
  payments       Payment[]
  tracker        Tracker?       // ← adiciona esta linha
  leads          LeadRequest[]
}

model VehicleLocation {
  id         Int      @id @default(autoincrement())
  trackerId  String
  tracker    Tracker  @relation(fields: [trackerId], references: [id])
  lat        Float
  lng        Float
  speed      Float?
  ignition   Boolean?
  timestamp  DateTime
  createdAt  DateTime @default(now())

  @@index([trackerId, timestamp])
}

model TrackerCommand {
  id         Int      @id @default(autoincrement())
  trackerId  String
  tracker    Tracker  @relation(fields: [trackerId], references: [id])
  command    String
  action     String
  response   String?
  sentBy     Int
  createdAt  DateTime @default(now())
}

model Customer {
  id              Int       @id @default(autoincrement())
  fullName        String
  phone           String
  email           String?
  address         String?
  licenseNumber   String
  licenseExpiry   DateTime?
  dlPhone         String?   // ← adiciona esta linha
  hasWhatsapp     Boolean   @default(false)
  whatsappNumber  String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  rentals         Rental[]
  payments        Payment[]
}

model LeadRequest {
  id             Int       @id @default(autoincrement())
  fullName       String
  email          String
  phone          String
  licenseNumber  String
  dlPhone        String?
  hasWhatsapp    Boolean   @default(false)
  whatsappNumber String?
  vehicleId      Int
  status         String    @default("new") // new, contacted, converted, rejected
  notes          String?
  convertedToId  Int?      // id do Customer criado ao converter
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id])
}

model Rental {
  id               Int       @id @default(autoincrement())
  customerId       Int
  vehicleId        Int
  startDate        DateTime
  expectedReturn   DateTime?
  actualReturn     DateTime?
  weeklyRate       Float
  deposit          Float     @default(0)
  status           String    @default("active") // active, finished, late, cancelled
  paymentDay       String?   // monday, tuesday, wednesday, thursday, friday, saturday, sunday
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  customer         Customer  @relation(fields: [customerId], references: [id])
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id])
  payments         Payment[]
}

model Payment {
  id         Int       @id @default(autoincrement())
  rentalId   Int?
  customerId Int
  vehicleId  Int?
  amount     Float
  paidAt     DateTime  @default(now())
  method     String    // cash, zelle, card, transfer, other
  type       String    // rental, deposit, fine, maintenance, other
  status     String    @default("paid") // paid, pending, late
  notes      String?
  createdAt  DateTime  @default(now())
  rental     Rental?   @relation(fields: [rentalId], references: [id])
  customer   Customer  @relation(fields: [customerId], references: [id])
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
}

model Maintenance {
  id                Int       @id @default(autoincrement())
  vehicleId         Int
  type              String    // preventive, corrective, cleaning, tires, oil, brakes, battery, other
  date              DateTime
  mileage           Int?
  cost              Float     @default(0)
  status            String    @default("pending") // pending, in_progress, completed
  shop              String?
  notes             String?
  nextMaintenanceDate DateTime?
  nextMileage       Int?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id])
}

model Tracker {
  id            String            @id
  vehicleId     Int               @unique
  label         String?
  simCard       String?
  notes         String?
  active        Boolean           @default(true)
  lastSeen      DateTime?         // ← adiciona essa linha
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  vehicle       Vehicle           @relation(fields: [vehicleId], references: [id])
  locations     VehicleLocation[]
  commands      TrackerCommand[]
}